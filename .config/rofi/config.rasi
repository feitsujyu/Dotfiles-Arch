/* rofi 配置
 * rofi 启动时会读取 ~/.config/rofi/config.rasi
 * 主题写在 ~/.config/rofi/themes/lilac.rasi（和 kitty / waybar / mango 使用同一套 Lilac 配色）
 */

configuration {
    modes:               "drun,run,window";
    show-icons:          true;
    font:                "JetBrainsMono Nerd Font 13";
    drun-display-format: "{name}";
    display-drun:        "󰀻 应用";
    display-run:         " 命令";
    display-window:      "󰖯 窗口";
}

@theme "lilac"
